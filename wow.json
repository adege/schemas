{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://raw.githubusercontent.com/adege/schemas/main/wow.json",
  "title": "WOW Schema",
  "description": "Root schema for WOW YAML documents",
  "examples": [
    "*.wow.yaml"
  ],

  "$defs": {

    "task-array": {
      "type": "array",
      "markdownDescription": "List of tasks",
      "additionalItems": false,
      "items": {
        "anyOf": [
          { "$ref": "wow-yaml.json#/$defs/yamllist" },
          {
            "allOf": [
              { "$ref": "wow-task.json#/$defs/task" },
              { "not": { "$ref": "wow-action.json#/$defs/action" } },
              { "not": { "$ref": "wow-command.json#/$defs/commandAction" } },
              { "not": { "$ref": "wow-command.json#/$defs/commandObject" } },
              { "not": { "$ref": "wow-command.json#/$defs/command" } },
              { "not": { "$ref": "wow-file.json#/$defs/fileAction" } },
              { "not": { "$ref": "wow-file.json#/$defs/fileObject" } },
              { "not": { "$ref": "wow-http.json#/$defs/httpAction" } },
              { "not": { "$ref": "wow-http.json#/$defs/httpObject" } },
              { "not": { "$ref": "wow-snippet.json#/$defs/snippetAction" } },
              { "not": { "$ref": "wow-snippet.json#/$defs/snippetObject" } },
              { "not": { "$ref": "wow-pool.json#/$defs/poolObject" }},
              { "not": { "$ref": "wow-endpoint.json#/$defs/endpoint" }},
              { "not": { "$ref": "wow-pipe.json#/$defs/stream" }},
              { "not": { "$ref": "wow-filter.json#/$defs/filter" }}
            ]
          }
        ]
      }
    },

    "action-array": {
      "type": "array",
      "markdownDescription": "List of action items and children",
      "additionalItems": false,
      "items": {
        "allOf": [
          {
            "anyOf": [
              { "$ref": "wow-yaml.json#/$defs/yamllist" },
              { "$ref": "wow-action.json#/$defs/action" },
              { "$ref": "wow-command.json#/$defs/commandAction" },
              { "$ref": "wow-command.json#/$defs/commandObject" },
              { "$ref": "wow-command.json#/$defs/command" },
              { "$ref": "wow-file.json#/$defs/fileAction" },
              { "$ref": "wow-file.json#/$defs/fileObject" },
              { "$ref": "wow-http.json#/$defs/httpAction" },
              { "$ref": "wow-http.json#/$defs/httpObject" },
              { "$ref": "wow-snippet.json#/$defs/snippetAction" },
              { "$ref": "wow-snippet.json#/$defs/snippetObject" }
            ]
          },
          { "not": { "$ref": "wow-task.json#/$defs/task" } },
          { "not": { "$ref": "wow-pool.json#/$defs/poolObject" }},
          { "not": { "$ref": "wow-endpoint.json#/$defs/endpoint" }},
          { "not": { "$ref": "wow-pipe.json#/$defs/stream" }},
          { "not": { "$ref": "wow-filter.json#/$defs/filter" }} BUNU SİLİNCE DÜZELİYOR ???!!!
        ]
      }
    },

    "pool-array": {
      "type": "array",
      "markdownDescription": "List of pools",
      "additionalItems": false,
      "items": {
        "anyOf": [
          { "$ref": "wow-yaml.json#/$defs/yamllist" },
          {
            "allOf": [
              { "$ref": "wow-pool.json#/$defs/poolObject" },
              { "not": { "$ref": "wow-task.json#/$defs/task" }},
              { "not": { "$ref": "wow-action.json#/$defs/action" } },
              { "not": { "$ref": "wow-command.json#/$defs/commandAction" } },
              { "not": { "$ref": "wow-command.json#/$defs/commandObject" } },
              { "not": { "$ref": "wow-command.json#/$defs/command" } },
              { "not": { "$ref": "wow-file.json#/$defs/fileAction" } },
              { "not": { "$ref": "wow-file.json#/$defs/fileObject" } },
              { "not": { "$ref": "wow-http.json#/$defs/httpAction" } },
              { "not": { "$ref": "wow-http.json#/$defs/httpObject" } },
              { "not": { "$ref": "wow-snippet.json#/$defs/snippetAction" } },
              { "not": { "$ref": "wow-snippet.json#/$defs/snippetObject" } },
              { "not": { "$ref": "wow-endpoint.json#/$defs/endpoint" }},
              { "not": { "$ref": "wow-pipe.json#/$defs/stream" }},
              { "not": { "$ref": "wow-filter.json#/$defs/filter" }}
            ]
          }
        ]
      }
    },

    "endpoint-array": {
      "type": "array",
      "markdownDescription": "List of endpoints",
      "additionalItems": false,
      "items": {
        "anyOf": [
          { "$ref": "wow-yaml.json#/$defs/yamllist" },
          {
            "allOf": [
              { "$ref": "wow-endpoint.json#/$defs/endpoint" },
              { "not": { "$ref": "wow-task.json#/$defs/task" }},
              { "not": { "$ref": "wow-action.json#/$defs/action" } },
              { "not": { "$ref": "wow-command.json#/$defs/commandAction" } },
              { "not": { "$ref": "wow-command.json#/$defs/commandObject" } },
              { "not": { "$ref": "wow-command.json#/$defs/command" } },
              { "not": { "$ref": "wow-file.json#/$defs/fileAction" } },
              { "not": { "$ref": "wow-file.json#/$defs/fileObject" } },
              { "not": { "$ref": "wow-http.json#/$defs/httpAction" } },
              { "not": { "$ref": "wow-http.json#/$defs/httpObject" } },
              { "not": { "$ref": "wow-snippet.json#/$defs/snippetAction" } },
              { "not": { "$ref": "wow-snippet.json#/$defs/snippetObject" } },
              { "not": { "$ref": "wow-pool.json#/$defs/poolObject" }},
              { "not": { "$ref": "wow-pipe.json#/$defs/stream" }},
              { "not": { "$ref": "wow-filter.json#/$defs/filter" }}
            ]
          }
        ]
      }
    },

    "stream-array": {
      "type": "array",
      "markdownDescription": "List of streams",
      "additionalItems": false,
      "items": {
        "anyOf": [
          { "$ref": "wow-yaml.json#/$defs/yamllist" },
          {
            "allOf": [
              { "$ref": "wow-pipe.json#/$defs/stream" },
              { "not": { "$ref": "wow-task.json#/$defs/task" }},
              { "not": { "$ref": "wow-action.json#/$defs/action" } },
              { "not": { "$ref": "wow-command.json#/$defs/commandAction" } },
              { "not": { "$ref": "wow-command.json#/$defs/commandObject" } },
              { "not": { "$ref": "wow-command.json#/$defs/command" } },
              { "not": { "$ref": "wow-file.json#/$defs/fileAction" } },
              { "not": { "$ref": "wow-file.json#/$defs/fileObject" } },
              { "not": { "$ref": "wow-http.json#/$defs/httpAction" } },
              { "not": { "$ref": "wow-http.json#/$defs/httpObject" } },
              { "not": { "$ref": "wow-snippet.json#/$defs/snippetAction" } },
              { "not": { "$ref": "wow-snippet.json#/$defs/snippetObject" } },
              { "not": { "$ref": "wow-pool.json#/$defs/poolObject" }},
              { "not": { "$ref": "wow-endpoint.json#/$defs/endpoint" }},
              { "not": { "$ref": "wow-filter.json#/$defs/filter" }}
            ]
          }
        ]
      }
    },

    "filter-array": {
      "type": "array",
      "markdownDescription": "List of filters",
      "additionalItems": false,
      "items": {
        "anyOf": [
          { "$ref": "wow-yaml.json#/$defs/yamllist" },
          {
            "allOf": [
              { "$ref": "wow-filter.json#/$defs/filter" },
              { "not": { "$ref": "wow-task.json#/$defs/task" }},
              { "not": { "$ref": "wow-action.json#/$defs/action" } },
              { "not": { "$ref": "wow-command.json#/$defs/commandAction" } },
              { "not": { "$ref": "wow-command.json#/$defs/commandObject" } },
              { "not": { "$ref": "wow-command.json#/$defs/command" } },
              { "not": { "$ref": "wow-file.json#/$defs/fileAction" } },
              { "not": { "$ref": "wow-file.json#/$defs/fileObject" } },
              { "not": { "$ref": "wow-http.json#/$defs/httpAction" } },
              { "not": { "$ref": "wow-http.json#/$defs/httpObject" } },
              { "not": { "$ref": "wow-snippet.json#/$defs/snippetAction" } },
              { "not": { "$ref": "wow-snippet.json#/$defs/snippetObject" } },
              { "not": { "$ref": "wow-pool.json#/$defs/poolObject" }},
              { "not": { "$ref": "wow-endpoint.json#/$defs/endpoint" }},
              { "not": { "$ref": "wow-pipe.json#/$defs/stream" }}
            ]
          }
        ]
      }
    }
  },

  "oneOf": [
    { "$ref": "wow-yaml.json#/$defs/yamllist-array" },
    {
      "oneOf": [
        { "$ref": "wow-yaml.json#/$defs/yamllist" },
        { "$ref": "#$defs/task-array" },
        { "$ref": "wow-task.json#/$defs/task" },
        { "$ref": "#$defs/action-array" },
        { "$ref": "wow-action.json#/$defs/action" },
        { "$ref": "wow-command.json#/$defs/commandAction" },
        { "$ref": "wow-command.json#/$defs/commandObject" },
        { "$ref": "wow-command.json#/$defs/command" },
        { "$ref": "wow-file.json#/$defs/fileAction" },
        { "$ref": "wow-file.json#/$defs/fileObject" },
        { "$ref": "wow-http.json#/$defs/httpAction" },
        { "$ref": "wow-http.json#/$defs/httpObject" },
        { "$ref": "wow-snippet.json#/$defs/snippetAction" },
        { "$ref": "wow-snippet.json#/$defs/snippetObject" },
        { "$ref": "#$defs/pool-array" },
        { "$ref": "wow-pool.json#/$defs/poolObject" },
        { "$ref": "#$defs/endpoint-array" },
        { "$ref": "wow-endpoint.json#/$defs/endpoint" },
        { "$ref": "#$defs/stream-array" },
        { "$ref": "wow-pipe.json#/$defs/stream" },
        { "$ref": "#$defs/filter-array" },
        { "$ref": "wow-filter.json#/$defs/filter" }
      ]
    }
  ]
}
