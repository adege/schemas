{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://raw.githubusercontent.com/adege/schemas/main/wow-pipe.json",
  "title": "WOW Pipe Schema",
  "description": "Schema for WOW pipes",

  "$defs": {

    "pipes": {
      "type": "array",
      "description": "List of pipes",
      "additionalItems": false,
      "items": {
        "anyOf": [
          {"$ref": "#$defs/stream"},
          {"$ref": "wow-yaml.json#/$defs/yamllist"},
          {"$ref": "wow-node.json#/$defs/auto-node"}
        ]
      }
    },

    "stream": {
      "type": "object",
      "description": "Stream Node",
      "required": [
      ],
      "additionalProperties": false,
      "properties": {
        "stream": {
          "type": ["string", "null"],
          "description": "Stream name"
        },
        "sources": {
          "type": [ 
            {"$ref": "#$defs/stream-sources-function"},
            {"$ref": "#$defs/stream-sources-list"},
            "string"
          ],
          "description": "Stream sources"
        },
        "pipes": {
          "$ref": "#$defs/pipes",
          "description": "Sub-stream pipes"
        },
        "filters": {
          "$ref": "wow-filter.json#/$defs/filters",
          "description": "Stream filters"
        }
      }
    },

    "stream-sources-function": {
      "type": "object",
      "description": "Stream sources function",
      "additionalProperties": false,
      "properties": {
        "startswith": {
          "type": "string",
          "description": "Source stream filter by startswith function"
        },
        "endswith": {
          "type": "string",
          "description": "Source stream filter by endswith function"
        },
        "contains": {
          "type": "string",
          "description": "Source stream filter by contains function"
        },
        "range": {
          "type": "string",
          "description": "Source stream filter by range function"
        },
        "regex": {
          "type": "string",
          "description": "Source stream filter by regex function"
        }
      }
    },

    "stream-sources-list": {
      "type": "array",
      "description": "List of stream sources",
      "additionalItems": false,
      "items": ["string"]
    }

  }

}
