{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://raw.githubusercontent.com/adege/schemas/main/wow-pool.json",
  "title": "WOW Pool Schema",
  "description": "Schema for WOW pool",

  "$defs": {

    "pool": {
      "type": "array",
      "description": "List of pools",
      "additionalItems": false,
      "items": [
        {"$ref": "#$defs/poolObject"},
        {"$ref": "wow-yaml.json#/$defs/yamllist"},
        {"$ref": "wow-node.json#/$defs/auto-node"}
      ]
    },

    "poolObject": {
      "type": "object",
      "description": "Pool",
      "additionalProperties": false,
      "required": ["group", "endpoints"],
      "properties": {
        "group": {
          "type": "string",
          "description": "Group of pool"
        },
        "spec": {
          "type": "string",
          "description": "Path of the pool spec file"
        },
        "endpoints": {
          "type": "array",
          "description": "List of endpoints",
          "additionalItems": false,
          "items": {
            "anyOf": [
              {"$ref": "wow-endpoint.json#/$defs/endpoint"},
              {"$ref": "wow-yaml.json#/$defs/yamllist"},
              {"$ref": "wow-node.json#/$defs/auto-node"}
            ]
          }
        }
      }
    }

  }

}
