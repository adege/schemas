{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://raw.githubusercontent.com/adege/schemas/main/wow-task.json",
  "title": "WOW Task Schema",
  "description": "Schema for WOW tasks",

  "$defs": {

    "task": {
      "type": "object",
      "description": "Task Node",
      "required": [
        "task",
        "actions"
      ],
      "additionalProperties": false,
      "properties": {
        "task": {
          "type": ["string", "null"],
          "description": "Task name"
        },
        "description": {
          "type": "string",
          "description": "Description of the task"
        },
        "out": {
          "type": "string",
          "description": "Base output path of task artifacts"
        },
        "subdir": {
          "type": "string",
          "description": "Sub-directory path in output path of task artifacts, where\n\nout_path = ${out}/${prefix}/${tag}/${subdir}"
        },
        "endpoint": {
          "type": "string",
          "description": "Default endpoint name"
        },
        "via": {
          "type": "string",
          "description": "Default via (access protocol name)"
        },
        "nolock": {
          "type": "boolean",
          "description": "Whether to not lock endpoints. By default, endpoints get locked. This variable can be used to disable locking."
        },
        "variables": {
          "type": "object",
          "description": "Global variables for this task"
        },
        "actions": {
          "$ref": "wow-action.json#/$defs/actions",
          "description": "Child actions.\n\nWhen a single action exists, it can be added as a mapping or a list item. If more than one actions exist, they have to be added as a list."
        }
      }
    }

  }

}
