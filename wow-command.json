{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://raw.githubusercontent.com/adege/schemas/main/wow-command.json",
  "title": "WOW Command Schema",
  "description": "Schema for WOW commands",

  "$defs": {

    "commandAction": {
      "type": "object",
      "description": "Command Action Node",
      "required": [
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": ["string", "null"],
          "description": "Action name"
        },
        "variables": {
          "type": "object",
          "description": "Action variables"
        },
        "endpoint": {
          "type": "string",
          "description": "Endpoint where this action is going to be executed.\n\nMust be a valid endpoint name."
        },
        "via": {
          "type": ["string", "array"],
          "description": "Access protocol to use in this action.\n\nWhen single via is given, only that via will be used. If a via list is given, first available via will be used."
        },
        "enabled": {
          "type": "boolean",
          "description": "Enable/disable this action."
        },
        "pipes": {
          "$ref": "wow-pipe.json#/$defs/pipes",
          "description": "Action pipes"
        },
        "filters": {
          "$ref": "wow-filter.json#/$defs/filters",
          "description": "Action base stream filters"
        },
        "commands": {
          "$ref": "#$defs/commands",
          "description": "List of commands"
        }
      }
    },

    "commands": {
      "type": "array",
      "description": "List of commands",
      "additionalItems": false,
      "items": {
        "anyOf": [
          {"$ref": "#$defs/commandObject"},
          {"$ref": "#$defs/command"},
          {"$ref": "wow-yaml.json#/$defs/yamllist"},
          {"$ref": "wow-node.json#/$defs/auto-node"}
        ]
      }
    },

    "commandObject": {
      "type": "object",
      "description": "Command Object",
      "required": [
        "command"
      ],
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string",
          "description": "Command"
        },
        "export": {
          "type": "string",
          "description": "Export variable"
        },
        "pipes": {
          "$ref": "wow-pipe.json#/$defs/pipes",
          "description": "Action pipes"
        },
        "filters": {
          "$ref": "wow-filter.json#/$defs/filters",
          "description": "Action base stream filters"
        }
      }
    },

    "command": {
      "type": "string",
      "description": "Plain Command"
    }

  }

}
