{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://raw.githubusercontent.com/adege/schemas/main/wow-endpoint.json",
  "title": "WOW Endpoint Schema",
  "description": "Schema for WOW endpoint",

  "$defs": {

    "endpoint": {
      "type": "object",
      "description": "Endpoint",
      "additionalProperties": true,
      "required": ["name", "viae"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of endpoint"
        },
        "viae": {"$ref": "#$defs/viae"}
      }
    },

    "viae": {
      "type": "object",
      "description": "Viae",
      "additionalProperties": false,
      "properties": {
        "ssh": {"$ref": "#$defs/sshVia"},
        "http": {"$ref": "#$defs/httpVia"}
      }
    },

    "sshVia": {
      "type": "object",
      "description": "SSH Via",
      "additionalProperties": false,
      "required": ["addr"],
      "properties": {
        "addr": {
          "type": "string",
          "description": "SSH address"
        },
        "port": {
          "type": "number",
          "description": "SSH port number"
        },
        "username": {
          "type": "string",
          "description": "SSH username"
        },
        "password": {
          "type": "string",
          "description": "SSH password"
        },
        "key_file": {
          "type": "string",
          "description": "Path of the SSH authentication key file"
        },
        "timeout": {
          "type": ["number", "string"],
          "description": "SSH timeout"
        },
        "env": {
          "type": "string",
          "description": "Environmanet variables"
        },
        "gather": {
          "type": "boolean",
          "description": "Enable/disable gather"
        }
      }
    },

    "httpVia": {
      "type": "object",
      "description": "HTTP Via",
      "additionalProperties": false,
      "required": ["addr"],
      "properties": {
        "protocol": {
          "enum": ["http", "https"],
          "description": "HTTP protocol"
        },
        "addr": {
          "type": "string",
          "description": "HTTP address"
        },
        "port": {
          "type": "number",
          "description": "HTTP port number"
        },
        "username": {
          "type": "string",
          "description": "HTTP username"
        },
        "password": {
          "type": "string",
          "description": "HTTP password"
        },
        "auth": {
          "type": "string",
          "description": "HTTP basic authentiction credentials as 'username:password'"
        },
        "timeout": {
          "type": ["number", "string"],
          "description": "HTTP timeout"
        },
        "verify": {
          "type": "boolean",
          "description": "Enable/disable verify"
        }
      }
    }

  }

}
